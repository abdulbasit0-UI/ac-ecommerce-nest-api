{
  "family": "ac-commerce-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/acCommerceApiTaskRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/ac-commerce-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "APP_PORT", "value": "3000" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "LOG_PRETTY", "value": "false" },
        { "name": "DB_SYNC", "value": "false" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "REDIS_PORT", "value": "6379" }
      ],
      "secrets": [
        { "name": "DB_HOST", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/DB_HOST" },
        { "name": "DB_USERNAME", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/DB_USERNAME" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/DB_PASSWORD" },
        { "name": "DB_NAME", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/DB_NAME" },
        { "name": "REDIS_HOST", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/REDIS_HOST" },
        { "name": "JWT_ACCESS_SECRET", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/JWT_ACCESS_SECRET" },
        { "name": "JWT_REFRESH_SECRET", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/JWT_REFRESH_SECRET" },
        { "name": "STRIPE_SECRET_KEY", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/STRIPE_SECRET_KEY" },
        { "name": "STRIPE_WEBHOOK_SECRET", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/STRIPE_WEBHOOK_SECRET" },
        { "name": "AWS_S3_BUCKET", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/AWS_S3_BUCKET" },
        { "name": "FRONTEND_URL", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/FRONTEND_URL" },
        { "name": "APP_URL", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/APP_URL" },
        { "name": "MAIL_HOST", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/MAIL_HOST" },
        { "name": "MAIL_USER", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/MAIL_USER" },
        { "name": "MAIL_PASSWORD", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ac-commerce/MAIL_PASSWORD" }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:3000/health/live').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ac-commerce-api",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
